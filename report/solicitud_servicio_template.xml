<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="solicitud_servicio_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2>Solicitud de servicio</h2>
                                <strong>Folio: </strong><span t-field="o.folio"/>
                            </div>
                            <div class="col-4 text-right">
                                <strong>Fecha de solicitud: </strong><span t-field="o.fecha_solicitud"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <th>Fecha de servicio</th>
                                    <td><span t-field="o.fecha_servicio"/></td>
                                    <th>Horario</th>
                                    <td>
                                        <span t-field="o.hora_inicio" t-options="{'widget': 'float_time'}"/>
                                        <span> a </span>
                                        <span t-field="o.hora_fin" t-options="{'widget': 'float_time'}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Estado</th>
                                    <td colspan="3"><span t-field="o.estado"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Datos del cliente</h4>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <th>Empresa</th>
                                    <td><span t-field="o.empresa_cliente"/></td>
                                    <th>Nombre</th>
                                    <td><span t-field="o.nombre_cliente"/></td>
                                </tr>
                                <tr>
                                    <th>Telefono</th>
                                    <td><span t-field="o.telefono_cliente"/></td>
                                    <th>Cargo</th>
                                    <td><span t-field="o.cargo_cliente"/></td>
                                </tr>
                                <tr>
                                    <th>E-mail</th>
                                    <td colspan="3"><span t-field="o.email_cliente"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Ubicacion del servicio</h4>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr>
                                    <th>Empresa</th>
                                    <td><span t-field="o.empresa_servicio"/></td>
                                    <th>Contacto</th>
                                    <td><span t-field="o.nombre_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>Telefono</th>
                                    <td><span t-field="o.telefono_servicio"/></td>
                                    <th>Cargo</th>
                                    <td><span t-field="o.cargo_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>E-mail</th>
                                    <td colspan="3"><span t-field="o.email_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>Calle</th>
                                    <td><span t-field="o.calle_servicio"/></td>
                                    <th>Numero exterior / interior</th>
                                    <td><span t-field="o.numero_exterior_servicio"/> / <span t-field="o.numero_interior_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>Colonia</th>
                                    <td><span t-field="o.colonia_servicio"/></td>
                                    <th>Ciudad / Estado</th>
                                    <td><span t-field="o.ciudad_servicio"/> / <span t-field="o.estado_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>Entre calles</th>
                                    <td colspan="3"><span t-field="o.entre_calles_servicio"/></td>
                                </tr>
                                <tr>
                                    <th>Referencias</th>
                                    <td colspan="3"><span t-field="o.referencias_servicio"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.estado == 'aprobada' or o.firma">
                            <h4 class="mt-4">Autorizacion</h4>
                            <table class="table table-sm table-bordered">
                                <tbody>
                                    <tr>
                                        <th>Autorizo</th>
                                        <td><span t-field="o.autoriza"/></td>
                                    </tr>
                                    <tr t-if="o.firma">
                                        <th>Firma</th>
                                        <td><span t-field="o.firma" t-options="{'widget': 'image'}" style="max-height: 90px; max-width: 260px;"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="o.motivo_rechazo">
                            <h4 class="mt-4">Motivo de rechazo</h4>
                            <p t-field="o.motivo_rechazo"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>